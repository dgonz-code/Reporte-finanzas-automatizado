# ===== IA (opcional) =====
# none        -> sin IA, $0 (por defecto). Todo se lee con codigo; las dudas las respondes tu con --preguntar.
# claude-code -> usa tu plan de Claude via `claude -p` (requiere Claude Code instalado y con sesion iniciada).
#                Sin costo adicional: cuenta contra el cupo de tu plan.
# api         -> API de Anthropic. Se paga por uso, APARTE de tu plan de $20. Requiere ANTHROPIC_API_KEY.
REPORTE_LLM=none
REPORTE_CLAUDE_CODE_MODEL=        # opcional: sonnet | opus (vacio = el de tu Claude Code)
ANTHROPIC_API_KEY=                # solo si REPORTE_LLM=api
REPORTE_MODEL=claude-sonnet-5-5   # solo api
REPORTE_EFFORT=low                # solo api
REPORTE_WEB=0                     # solo api: 1 = busca en internet los comercios dudosos

# ===== Cartolas =====
# Cuenta corriente: llega por correo. Clave del PDF (solo en tu .env local; nunca en el repo):
PDF_PASSWORD=
GMAIL_QUERY_CUENTA=from:cartolas.info@scotiabank.cl has:attachment filename:pdf newer_than:35d
# Tarjeta: la descargas a mano. Carpeta donde dejas el .xls (puede ser tu carpeta Descargas):
REPORTE_ENTRADA=entrada
REPORTE_TARJETA_GLOB=Estado-de-Cuenta*.xls*

# ===== Clasificador =====
REPORTE_ASK_MIN=20000             # no te pregunta por dudas de monto acumulado menor a este

# ===== Salidas =====
REPORTE_SHEET_ID=                 # vacio = crea la planilla la primera vez (queda en data/sheet_id.txt)
REPORT_TO=                        # vacio = tu propia cuenta de Gmail
