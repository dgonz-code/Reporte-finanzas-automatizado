ANTHROPIC_API_KEY=
# Modelo usado para extraer y analizar (por defecto claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Busqueda en Gmail del correo de la cartola (sintaxis de busqueda de Gmail)
GMAIL_QUERY=from:(@tubanco.cl) has:attachment filename:pdf newer_than:35d
# Clave del PDF si viene protegido (en muchos bancos chilenos es el RUT sin DV)
PDF_PASSWORD=
# Destinatario del reporte (por defecto, tu propia cuenta de Gmail)
REPORT_TO=
