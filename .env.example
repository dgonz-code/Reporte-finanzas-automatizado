ANTHROPIC_API_KEY=

# --- Modelo y costo (evaluacion de costo minimo) ---
REPORTE_MODEL=claude-sonnet-5-5
REPORTE_EFFORT=low          # low | medium | high. Para extraer/clasificar, low basta.

# --- Gmail (solo para el modo automatico) ---
# Sintaxis de busqueda de Gmail. Ajusta el remitente real de cada correo.
GMAIL_QUERY_CUENTA=from:(@scotiabank.cl) has:attachment filename:pdf newer_than:35d
GMAIL_QUERY_TARJETA=from:(@scotiabank.cl) has:attachment filename:xls newer_than:35d

# Clave del PDF de la cuenta corriente (muchos bancos usan el RUT sin puntos ni DV)
PDF_PASSWORD=
# Destinatario del reporte (por defecto, tu propia cuenta de Gmail)
REPORT_TO=
